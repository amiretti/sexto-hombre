rules_version = '2';

// Fase 0 · uso interno
// - Solo entran cuentas de Google cuyo correo está en la colección allowlist (un documento por correo, en minúsculas).
// - Cada partido, club y plantel es de quien lo creó (ownerUid). Las jugadas heredan el permiso del partido.
// - Nada se borra físicamente: los partidos y las jugadas se marcan con deleted: true.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function allowed() {
      return signedIn() && exists(/databases/$(database)/documents/allowlist/$(email()));
    }

    match /allowlist/{mail} {
      allow get: if signedIn() && email() == mail;
      allow list, write: if false; // se administra desde la consola
    }

    match /users/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }

    match /teams/{teamId} {
      allow read: if allowed() && resource.data.ownerUid == request.auth.uid;
      allow create: if allowed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if allowed()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /clubs/{clubId} {
      allow read: if allowed() && resource.data.ownerUid == request.auth.uid;
      allow create: if allowed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if allowed()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /games/{gameId} {
      allow read: if allowed() && resource.data.ownerUid == request.auth.uid;
      allow create: if allowed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if allowed()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;

      match /events/{eventId} {
        function ownsGame() {
          return get(/databases/$(database)/documents/games/$(gameId)).data.ownerUid == request.auth.uid;
        }
        allow read: if allowed() && ownsGame();
        allow create, update: if allowed() && ownsGame()
          && request.resource.data.ownerUid == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
